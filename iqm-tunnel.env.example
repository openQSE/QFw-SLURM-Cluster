# Copy to iqm-tunnel.env and fill in. Used by ./iqm-tunnel.sh.
#
# IQM_HOST must be the hostname the IQM endpoint is known by *from hub* -- the
# same host that appears in the URL your IQM account documentation gives you.
# Use the hostname, not an IP: the containers connect with this name so the
# server's TLS certificate has to match it.
IQM_HOST=qccsw.ccs.ornl.gov

# Port of the IQM endpoint on that host.
IQM_PORT=443

# ssh destination for the hub node: a Host alias from ~/.ssh/config, or
# user@hostname.
HUB=hub

# Local port the tunnel listens on. Must match the port in the url: of
# shared-dir/iqm-device-access.yaml. Ports below 1024 need root on the host,
# which is why this is not 443.
LOCAL_PORT=8443
