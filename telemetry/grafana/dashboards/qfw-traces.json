{
  "id": null,
  "uid": "qfw-traces",
  "title": "QFw Traces",
  "description": "Trace search over QFw's spans in Tempo. Open a trace for the waterfall of one job.",
  "tags": [
    "qfw"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 0,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "table",
      "title": "Recent jobs",
      "description": "Every qfw.app.job is one job's trace: the Qiskit client's submit() to result(), with the QPM's receive, queue and dispatch and the run queue's provider call underneath.",
      "datasource": {
        "type": "tempo",
        "uid": "qfw-tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 11
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "qfw-tempo"
          },
          "queryType": "traceql",
          "query": "{ name = \"qfw.app.job\" }",
          "limit": 25,
          "tableType": "traces",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "traceDuration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "displayName",
                "value": "Duration"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "startTime"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Start time"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "traceService"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Service"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "traceName"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Root span"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "traceID"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Trace"
              },
              {
                "id": "custom.width",
                "value": 300
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "nested"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Start time",
            "desc": true
          }
        ]
      }
    },
    {
      "type": "table",
      "title": "Slowest provider interactions",
      "description": "Traces holding a qfw.backend.execute span, longest first. Expand a row for the span itself, with the device, API path and outcome it carried.",
      "datasource": {
        "type": "tempo",
        "uid": "qfw-tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 11
      },
      "targets": [
