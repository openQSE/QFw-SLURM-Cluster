          "datasource": {
            "type": "tempo",
            "uid": "qfw-tempo"
          },
          "queryType": "traceql",
          "query": "{ name = \"qfw.backend.execute\" } | select(span.qfw.device.name, span.qfw.stack.api_path, span.qfw.outcome)",
