qfw-install.env
.env
*.swp

# IQM access (see IQM-ACCESS.md). Site- and user-specific; the .example
# templates beside them are tracked. iqm-creds.json holds a live API token --
# never commit it.
iqm-tunnel.env
docker-compose.override.yml
/shared-dir/iqm-device-access.yaml
/shared-dir/iqm-creds.json

# IBM QSA simulator values for qsa-sim-head (see
# docs/recipes/start-ibm-qsa-sim.md).
/shared-dir/qsa-sim-device-access.yaml
/shared-dir/qsa-sim-creds.json

# Local diagnostic output
/shared-dir/qrmi_target_dump.json

# Build artifacts written into the bind-mounted shared-dir by the QFw build
/shared-dir/build/
/shared-dir/install/
/shared-dir/source/
/shared-dir/venv/
/shared-dir/benchmarks/
/shared-dir/rocm/

# QFw is its own git repo (openQSE/QFw); don't track it from the outer repo
/shared-dir/QFw/

# SLURM job output captured in the shared dir
/shared-dir/*.out

# In-container QFw build (do_qfw_build.sh) writes these to the shared mount
/shared-dir/qfw-build/
/shared-dir/qfw-install/
/shared-dir/qfw-venv/
/shared-dir/qfw-site-services/

# MQT Core developer override
/shared-dir/mqt-core/

# Licensed GAMESS source, build products, and calculation output.
/shared-dir/gamess/

# ElectroBoy local runtime state
.electroboy/local/
.electroboy/shared/runs/*/progress/
/shared-dir/chemistry_he/
/shared-dir/streamflow-chemistry/
/shared-dir/home/
/streamflow/chemistry/**/__pycache__/
